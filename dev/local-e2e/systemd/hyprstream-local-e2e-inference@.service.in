[Unit]
Description=Hyprstream local E2E CPU inference replica %i
Requires=hyprstream-local-e2e-policy.service hyprstream-local-e2e-discovery.service
After=hyprstream-local-e2e-policy.service hyprstream-local-e2e-discovery.service
PartOf=hyprstream-local-e2e.target

[Service]
Type=notify
RuntimeDirectory=hyprstream
RuntimeDirectoryMode=0700
Environment=HYPRSTREAM_INSTANCE=inference-cpu-%i
Environment=HYPRSTREAM__SECRETS__PATH=@@RUNTIME_DIR@@/credentials/inference-cpu-%i
Environment=HYPRSTREAM_SECRETS_PROFILE=per-service-scoped
EnvironmentFile=@@CONFIG_DIR@@/runtime.env
EnvironmentFile=@@CONFIG_DIR@@/trust-loader.env
ExecStartPre=@@HARNESS_DIR@@/require-user-trust-loader.sh
ExecStartPre=@@HARNESS_DIR@@/preflight-inference.sh %i
ExecStart=@@HYPRSTREAM_BIN@@ --config @@CONFIG_DIR@@/inference-%i.toml service start inference --foreground --ipc
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=hyprstream-local-e2e.target
