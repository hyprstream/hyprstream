[Unit]
Description=Hyprstream local E2E policy service
PartOf=hyprstream-local-e2e.target

[Service]
Type=notify
RuntimeDirectory=hyprstream
RuntimeDirectoryMode=0700
Environment=HYPRSTREAM__SECRETS__PATH=@@RUNTIME_DIR@@/credentials/policy
Environment=HYPRSTREAM_SECRETS_PROFILE=per-service-scoped
EnvironmentFile=@@CONFIG_DIR@@/runtime.env
EnvironmentFile=@@CONFIG_DIR@@/trust-loader.env
ExecStartPre=@@HARNESS_DIR@@/require-user-trust-loader.sh
ExecStart=@@HYPRSTREAM_BIN@@ --config @@CONFIG_DIR@@/pds.toml service start policy --foreground --ipc
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=hyprstream-local-e2e.target
