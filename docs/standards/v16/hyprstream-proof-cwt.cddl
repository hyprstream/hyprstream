; Canonical CDDL (RFC 8610) for the Hyprstream RPC request-proof profile
; `hs-rpc-proof-v1`: the proof CWT claims set, the response-binding structure,
; the canonical signature plan, and the private-use COSE header parameters.
;
; Status: gate-2 input draft. This file is the normative structure for the
; profile freeze; it is not operator-approved and authorizes no implementation.
;
; Encoding: RFC 8949 core deterministic encoding, restricted further by this
; profile — definite lengths only, deterministically ordered unique map keys,
; integer timestamps, no floating-point values anywhere, no tags (including the
; CWT and COSE object tags), and no duplicate claim keys. The claim set is
; closed: an unknown claim key denies rather than being ignored.
;
; Values marked PROPOSED are concrete proposals for gate-2 approval where the
; controlling design leaves the value to the gate. Every other value traces to
; a design section cited in the comment above it.
;
; The `external_aad` of every `Sig_structure` in this profile is zero-length:
; the signed body protected headers are self-describing, so no separately
; supplied bytes participate in verification.

; ==========================================================================
; 1. Profile constants
; ==========================================================================

; Media types (RFC 6838 vendor tree, `+cwt` suffix per RFC 9782). Registration
; in the IANA media types registry is REQUIRED before the production freeze.
proof-typ          = "application/vnd.hyprstream.proof+cwt"
response-proof-typ = "application/vnd.hyprstream.response-proof+cwt"

; Application cryptographic domain separators, carried in every Sig_structure.
request-proof-domain  = "hs-rpc-request-proof-v1"
response-proof-domain = "hs-rpc-response-proof-v1"

; Versioned suite registry identifiers.
suite-classical = "hs-cose-sign-ed25519-v1"              ; exactly Ed25519 (-19)
suite-hybrid    = "hs-cose-sign-ed25519-mldsa65-wns-v1"  ; Ed25519 (-19) + ML-DSA-65 (-49)
suite-id        = suite-classical / suite-hybrid

; Fully specified COSE algorithms (RFC 9864). The deprecated polymorphic
; `EdDSA` (-8) is not part of this profile and denies.
alg-ed25519   = -19
alg-ml-dsa-65 = -49
profile-alg   = alg-ed25519 / alg-ml-dsa-65

; ==========================================================================
; 2. proof-v1 caps
; ==========================================================================
;
; These caps are exact. Raising one after the profile freeze is an
; incompatible profile revision; implementations MUST NOT silently accept a
; larger value.
;
;   signer groups per plan .................. 1..8
;   components per signer group ............. 1..2
;   signature entries per proof ............. 1..16 (groups x components)
;   suite_id ................................ 1..64 encoded bytes
;   kid ..................................... 1..64 bytes
;   cti (request_id) ........................ exactly 16 bytes
;   credential_hash ......................... exactly 32 bytes (SHA-256)
;   Nonce (server challenge) ................ 16..64 bytes
;   aud (canonical service domain) .......... 1..253 bytes            PROPOSED
;   capnp body bytes ........................ 0..1048576 bytes        PROPOSED
;   total encoded COSE object ............... <= 2097152 bytes        PROPOSED
;   crit array entries ...................... 1..4 (exact sets, §5)
;   unattributed key-set elements ........... 1..2 (= plan components)
;
; The `capnp body bytes` and total-object caps are the profile ceiling; a
; transport or deployment MAY impose a smaller frame limit. The `aud` cap is
; the DNS-name ceiling; canonical service domains are not required to be DNS
; names, only to fit it.

max-kid-bytes    = 64
max-suite-bytes  = 64
max-body-bytes   = 1048576   ; PROPOSED
max-aud-bytes    = 253       ; PROPOSED

; ==========================================================================
; 3. Proof CWT claims sets
; ==========================================================================
;
; Presence versus null: every listed claim is always present. A claim whose
; value is inapplicable is encoded as CBOR `null`. An absent listed claim, like
; an unknown claim key, denies. `Nonce` is the single exception: it is present
; exactly when the profile requires a challenge and absent otherwise.

hyprstream-proof-claims = {
  3  => canonical-service-domain,   ; aud   — intended recipient service
  4  => timestamp,                  ; exp   — proof expiry
  6  => timestamp,                  ; iat   — proof issuance
  7  => request-id,                 ; cti   — the request identifier
  ? 10 => server-challenge,         ; Nonce — RFC 9711; REQUIRED unattributed
  -70001 => credential-hash / null,
  -70002 => capnp-schema-id,
  -70003 => capnp-body-bytes,
  -70004 => response-binding / null,
}

; The response proof reuses the identical claim structure; the protected `typ`
; and `hs_domain` separate the two profiles, and the claim semantics below are
; the response overlay. PROPOSED: reusing the same four private-use claim keys
; rather than allocating a second block.
;
;   3  aud   — the same canonical service domain the request was bound to
;   7  cti   — the request_id of the request being answered (binding, not a
;              new identifier); a mismatched cti denies
;   10 Nonce — always absent
;   -70001   — always null; a response proof is never credential-bound
;   -70002   — the Cap'n Proto 64-bit type ID of the response root type
;   -70003   — the exact Cap'n Proto response body bytes
;   -70004   — the realized response binding, or null for an unbound response
hyprstream-response-proof-claims = hyprstream-proof-claims

canonical-service-domain = tstr .size (1..253)   ; PROPOSED size cap
timestamp                = uint                  ; integer Unix seconds
request-id               = bstr .size 16         ; 128 bits of CSPRNG output
server-challenge         = bstr .size (16..64)
credential-hash          = bstr .size 32         ; SHA-256 of the exact token bytes
capnp-schema-id          = uint                  ; Cap'n Proto 64-bit type ID
capnp-body-bytes         = bstr .size (0..1048576)   ; PROPOSED size cap

; ==========================================================================
; 4. Response binding
; ==========================================================================
;
; PROPOSED structure. The controlling design fixes what a response binding
; binds (response schema domain, exact response bytes, and the request's signed
; response/KEM material) and leaves the encoding to gate 2.
;
; In a request proof the map is the client's commitment to how the response
; must be produced. It is null when the response is neither encrypted nor
; streamed. In a response proof it is the realized binding and MUST equal the
; request's map field-for-field where both are present.

response-binding = {
  1 => capnp-schema-id,        ; response root type ID (response schema domain)
  2 => response-mode,
  3 => kem-recipient / null,   ; non-null iff mode is encrypted
}

response-mode = 1 / 2 / 3      ; 1 = unary cleartext, 2 = unary encrypted,
                               ; 3 = stream setup                  PROPOSED

; ML-KEM-768 recipient material for an encrypted response. The `alg` slot
; carries the profile's KEM identifier: PROPOSED private-use value -70200 until
; `draft-ietf-cose-hpke-pq-pqt` registers the PQ/T KEM identifiers, at which
; point the registered value replaces it in an incompatible profile revision.
; This is a recorded watch item; nothing in this profile depends on the draft.
kem-recipient = {
  1 => int,                    ; COSE KEM algorithm identifier
  2 => bstr .size 1184,        ; ML-KEM-768 encapsulation key
  3 => bstr .size (1..64),     ; kid of the recipient key
}

; ==========================================================================
; 5. Private-use COSE header parameters
; ==========================================================================
;
;   -70100  hs_domain                 tstr
;   -70101  hs_signature_plan         signature-plan
;   -70102  hs_logical_signer_group   uint
;   -70103  hs_unattributed_key_set   COSE_KeySet (RFC 9052 §7)
;
; Placement is normative and differs by structure. `typ` and `hs_domain` are
; deliberately redundant: `typ` types the complete COSE object and rejects
; object-type confusion, `hs_domain` is the application cryptographic domain
; separator inside every Sig_structure. Both are protected; both must match.

; ---- COSE_Sign body protected headers -------------------------------------

proof-sign-body-protected = proof-sign-body-authenticated
                          / proof-sign-body-unattributed

proof-sign-body-authenticated = {
  2  => [-70101, -70100],            ; crit, exact
  16 => proof-typ / response-proof-typ,
  -70100 => request-proof-domain / response-proof-domain,
  -70101 => signature-plan,
}

proof-sign-body-unattributed = {
  2  => [-70103, -70101, -70100],    ; crit, exact
  16 => proof-typ,                   ; never the response-proof type
  -70100 => request-proof-domain,
  -70101 => signature-plan,
  -70103 => unattributed-key-set,
}

; ---- COSE_Sign per-signature protected headers ----------------------------

proof-sign-signature-protected = {
  1  => profile-alg,
  2  => [-70102],                    ; crit, exact
  4  => kid,
  -70102 => logical-signer-group,
}

; ---- COSE_Sign1 merged protected bucket -----------------------------------

proof-sign1-protected = proof-sign1-authenticated / proof-sign1-unattributed

proof-sign1-authenticated = {
  1  => profile-alg,
  2  => [-70102, -70101, -70100],    ; crit, exact
  4  => kid,
  16 => proof-typ / response-proof-typ,
  -70100 => request-proof-domain / response-proof-domain,
  -70101 => signature-plan,
  -70102 => logical-signer-group,
}

proof-sign1-unattributed = {
  1  => profile-alg,
  2  => [-70103, -70102, -70101, -70100],   ; crit, exact
  4  => kid,
  16 => proof-typ,
  -70100 => request-proof-domain,
  -70101 => signature-plan,
  -70102 => logical-signer-group,
  -70103 => unattributed-key-set,
}

; `crit` entries are exact sets in ascending numeric-label order, unique, and
; every listed label MUST occur in the same protected bucket. A missing, extra,
; duplicate, unknown, or misplaced entry denies before claims or signatures
; establish authority. The unprotected header bucket carries nothing that
; establishes authority; a profile verifier requires it to be empty.

kid                   = bstr .size (1..64)
logical-signer-group  = uint .le 255       ; PROPOSED numeric ceiling

; ==========================================================================
; 6. Signature plan
; ==========================================================================
;
; The plan is the signed, canonical description of every logical signer group
; and every component expected from that group. It is the complete set of
; groups that actually sign: no plan group may lack its complete signatures and
; no signature may sit outside the plan.
;
; Groups are sorted by ascending group_id and group IDs are unique. Component
; order is the exact order declared by the versioned suite registry, and every
; (alg, kid) pair is unique across the complete plan.

signature-plan = [ 1*8 signer-group ]

signer-group = {
  1 => logical-signer-group,           ; group_id
  2 => suite-id-bounded,               ; suite_id
  3 => [ 1*2 signature-component ],
}

signature-component = {
  1 => profile-alg,                    ; COSE alg, fully specified
  2 => kid,
}

; The suite registry is closed; the bounded form records the encoded-length cap
; that a verifier enforces before consulting the registry.
suite-id-bounded = tstr .size (1..64)

; Suite registry (versioned, checked in with this profile):
;
;   hs-cose-sign-ed25519-v1
;     components: [ Ed25519 (-19) ]
;     key types:  OKP / Ed25519
;     rule:       exactly one component; the single signature authenticates the
;                 logical signer.
;
;   hs-cose-sign-ed25519-mldsa65-wns-v1
;     components: [ Ed25519 (-19), ML-DSA-65 (-49) ] in this exact order
;     key types:  OKP / Ed25519, then AKP / ML-DSA-65
;     rule:       exactly two components in one logical signer group; both MUST
;                 verify; the pair counts as one logical signer, never two
;                 approvals. Weakly non-separable per RFC 9955: the components
;                 are distinct signature objects bound to this suite by the
;                 signed plan covered by every Sig_structure.
;
; A component key enrolled for the hybrid suite MUST NOT be simultaneously
; enrolled for a standalone suite, another hybrid construction, another
; protocol/domain separator, or a different logical signer group.
;
; Watch item: `draft-ietf-jose-pq-composite-sigs` defines the fused
; `COMPSIG-MLDSA65-Ed25519-SHA512` algorithm. Adopting it is an incompatible
; profile revision (new typ, new key enrollment, new vectors), not a suite-table
; substitution. Nothing in this profile depends on that draft.

; ==========================================================================
; 7. Unattributed key set
; ==========================================================================
;
; The standard `COSE_KeySet` structure of RFC 9052 §7 (an array of COSE_Key
; values), carried in the body protected headers of an unattributed proof and
; forbidden everywhere else — with a credential presented, and in every
; response proof.
;
; This closed profile is stricter than RFC 9052's element processing: every
; element MUST parse, be understood, and match exactly one plan component by
; kid, algorithm, key type, and curve or parameter set, in the plan's component
; order. A malformed, unknown, duplicate, surplus, private, reordered, or
; mismatched key denies the complete proof; it is never ignored while the
; remaining keys establish authority. Private key material is forbidden.
;
; The self-asserted key set proves only internal proof consistency. It grants
; no identity, role, clearance, tenant, or assurance.

unattributed-key-set = [ 1*2 unattributed-key ]

unattributed-key = cose-key-okp-ed25519 / cose-key-akp-ml-dsa-65

cose-key-okp-ed25519 = {
  1  => 1,                 ; kty: OKP
  2  => kid,
  3  => alg-ed25519,
  -1 => 6,                 ; crv: Ed25519
  -2 => bstr .size 32,     ; x: public key
}

cose-key-akp-ml-dsa-65 = {
  1  => 7,                 ; kty: AKP (RFC 9964)
  2  => kid,
  3  => alg-ml-dsa-65,
  -1 => bstr .size 1952,   ; pub: ML-DSA-65 public key (RFC 9964)
}

; The replay namespace for an unattributed proof is the SHA-256 thumbprint of
; the canonical deterministic encoding of the tuple
;   [ signature-plan, unattributed-key-set ]
; under the proof-key-set domain separator, so every component key and its
; suite/group interpretation binds the replay key and no single component
; thumbprint can alias a hybrid signer.

; ==========================================================================
; 8. Complete objects
; ==========================================================================
;
; Untagged COSE structures per RFC 9052; object typing is performed by the
; protected `typ` header, not by a CBOR tag. The payload is embedded (never
; detached) and is the deterministic encoding of the claims set.

hyprstream-proof-sign1 = [
  protected   : bstr .cbor proof-sign1-protected,
  unprotected : {},
  payload     : bstr .cbor hyprstream-proof-claims,
  signature   : bstr,
]

hyprstream-proof-sign = [
  protected   : bstr .cbor proof-sign-body-protected,
  unprotected : {},
  payload     : bstr .cbor hyprstream-proof-claims,
  signatures  : [ 1*16 hyprstream-proof-signature ],
]

hyprstream-proof-signature = [
  protected   : bstr .cbor proof-sign-signature-protected,
  unprotected : {},
  signature   : bstr,
]

; COSE_Sign1 is used when one signature entry suffices; COSE_Sign when the
; cryptographic suite or authorization policy requires several entries. Each
; signature entry matches exactly one component in the signed plan by protected
; group, alg, and kid. A missing component, duplicate component, extra
; signature, reordered or malformed plan, group/suite mismatch, or key outside
; the applicable anchored record or unattributed key set denies.
